# Copy this file to  backend\.env  and fill in ONE of the Indic OCR options, then restart the server.

# --- Which OCR engine reads the text -------------------------------------------------
#   tesseract     offline, no setup (default)
#   bodhan_api    Bodhan IndicOCR hosted API  (works on any laptop; ~Rs 0.20 per page)
#   indic_server  IndicOCR running on a GPU machine / free Google Colab (see ocr_server/)
#   indic_local   IndicOCR inside this app (only on a PC with an NVIDIA GPU)
OCR_ENGINE=tesseract

# --- Option A: Bodhan hosted API (console.bodhan.ai -> API keys) ---------------------
# BODHAN_API_KEY=paste-your-key-here
# BODHAN_MODEL=paste-the-document-OCR-model-id-from-console.bodhan.ai/api-docs
# BODHAN_API_URL=https://api.bodhan.ai/v1/chat/completions

# --- Option B: your own IndicOCR server (Colab) --------------------------------------
# INDIC_OCR_URL=https://something.trycloudflare.com
# INDIC_OCR_TOKEN=token-printed-by-the-colab-notebook
